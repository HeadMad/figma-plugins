  "type": "css-module",
  "variables": {
    "--bg-main": {
      "description": "Main panel background."
    },
    "--bg-field": {
      "description": "Input field background."
    },
    "--bg-field-hover": {
      "description": "Input field hover background."
    },
    "--color-text": {
      "description": "Primary text color."
    },
    "--color-muted": {
      "description": "Muted label/icon color."
    },
    "--color-primary": {
      "description": "Accent/primary action color."
    },
    "--color-primary-light": {
